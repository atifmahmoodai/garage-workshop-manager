# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# docker-compose builds DATABASE_URL from POSTGRES_PASSWORD. Outside Docker set it yourself:
# DATABASE_URL=postgres://workshop:PASSWORD@localhost:5432/workshop

# --- Web ---
# The address staff use (https in production). Cross-site requests from other origins are refused.
PUBLIC_URL=http://localhost:8080
# Behind nginx / Caddy / a cloud load balancer that terminates https:
TRUST_PROXY=false
# Secure cookies need https. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
NODE_ENV=production
APP_PORT=8080

# Workshop time zone (IANA name): decides "today" for the board, bookings and reports.
TIMEZONE=America/New_York

# --- Sessions ---
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=12

LOG_LEVEL=info
RATE_LIMIT_PER_MIN=300
